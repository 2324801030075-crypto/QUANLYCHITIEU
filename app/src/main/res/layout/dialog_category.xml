<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:text="CHỌN BIỂU TƯỢNG"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/imgSelectedIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:padding="10dp"
        android:background="@drawable/bg_category_item"
        android:src="@android:drawable/ic_menu_gallery"/>

    <TextView
        android:text="TÊN DANH MỤC"
        android:textSize="12sp"
        android:textColor="#777"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etCatName"
        android:hint="Ví dụ: Ăn uống"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <TextView
        android:text="DANH SÁCH BIỂU TƯỢNG"
        android:textSize="12sp"
        android:textColor="#777"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIconPicker"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scrollbars="vertical"/>

    <Button
        android:id="@+id/btnSaveCat"
        android:text="LƯU THAY ĐỔI"
        android:layout_marginTop="20dp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
</LinearLayout>
